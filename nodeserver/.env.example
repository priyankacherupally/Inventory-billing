NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# MongoDB (local, no auth)
MONGODB_URI=mongodb://localhost:27017/saree_shop

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Seed credentials (first-run only; change after first login)
SEED_ADMIN_USERNAME=priyanka
SEED_ADMIN_PASSWORD=Admin@123
SEED_BILLING_USERNAME=nikhil
SEED_BILLING_PASSWORD=Billing@123

# Shop details (printed on every bill)
SHOP_NAME=My Saree House
SHOP_ADDRESS=123, Main Street, City
SHOP_PHONE=+91 99999 99999
